# Plantilla de variables de entorno. Copiar a .env y completar los valores reales.

CONNECTION_STRING=<host>;Port=<puerto>;Database=<base_de_datos>;User=<usuario>;Password=<contrasena>;SslMode=Required;

# Autenticación JWT (Incremento 1)
JWT_KEY=<clave larga y aleatoria, mínimo 32 caracteres>
JWT_ISSUER=ApiAutoLavado
JWT_AUDIENCE=ApiAutoLavadoClientes
JWT_EXPIRACION_MINUTOS=60

# Usuario Administrador inicial (se crea solo si la tabla usuarios está vacía)
ADMIN_USUARIO=admin
ADMIN_CONTRASENA=<contrasena del administrador inicial>

# Contraseña de los operarios sembrados al inicializar la base de datos
OPERARIO_CONTRASENA=<contrasena de los operarios de prueba>
